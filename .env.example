# Google Gemini — leave empty to run with the built-in local generator.
GEMINI_API_KEY=
# Model chain: Flash first, Pro as fallback (matches the project architecture).
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-pro

# Optional overrides
# FITBUDDY_DATABASE_URL=sqlite:///./fitbuddy.db
# FITBUDDY_LOG_LEVEL=INFO
